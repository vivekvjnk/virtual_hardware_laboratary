#!/usr/bin/env node

import { resolve, dirname, basename } from "node:path";
import { existsSync, mkdirSync } from "node:fs";

function printUsage() {
    console.log(`
Usage: vhl_evaluate_circuit [options]

Options:
  --file <path>         Path to the circuit .tsx file to evaluate directly
  --module <name>       Module name in active or specified project
  --circuit <name>      Circuit file name (default: <module>.tsx)
  --project <id>        Project ID (optional if active project loaded)
  --port <number>       VHL API port (default: env VHL_API_PORT or 3022)
  --timeout <ms>        Evaluation timeout in milliseconds (default: 300000)
  --json                Output raw JSON result
  --help                Show this help message

Examples:
  vhl_evaluate_circuit --file /path/to/project/module/Workspace/circuit.tsx
  vhl_evaluate_circuit --module power_stage --project bms_alpha
  vhl_evaluate_circuit --file index.circuit.tsx --timeout 60000
`);
}

function parseArgs() {
    const args = process.argv.slice(2);
    const parsed = {
        file: null,
        module: null,
        circuit: null,
        project: null,
        port: process.env.VHL_API_PORT ? parseInt(process.env.VHL_API_PORT, 10) : 3022,
        timeout: 300000,
        json: false
    };

    for (let i = 0; i < args.length; i++) {
        const arg = args[i];
        if (arg === "--help" || arg === "-h") {
            printUsage();
            process.exit(0);
        } else if (arg === "--file" || arg === "-f") {
            parsed.file = args[++i];
        } else if (arg === "--module" || arg === "-m") {
            parsed.module = args[++i];
        } else if (arg === "--circuit" || arg === "-c") {
            parsed.circuit = args[++i];
        } else if (arg === "--project" || arg === "-p") {
            parsed.project = args[++i];
        } else if (arg === "--port") {
            parsed.port = parseInt(args[++i], 10);
        } else if (arg === "--timeout" || arg === "-t") {
            parsed.timeout = parseInt(args[++i], 10);
        } else if (arg === "--json") {
            parsed.json = true;
        }
    }

    return parsed;
}

async function main() {
    const opts = parseArgs();

    if (!opts.file && !opts.module) {
        console.error("Error: Either --file <path> or --module <name> must be specified.");
        printUsage();
        process.exit(1);
    }

    const payload = {};
    if (opts.file) {
        payload.file_path = resolve(process.cwd(), opts.file);
    }
    if (opts.module) {
        payload.module_name = opts.module;
    }
    if (opts.circuit) {
        payload.circuit_name = opts.circuit;
    }
    if (opts.project) {
        payload.project_id = opts.project;
    }
    if (opts.timeout) {
        payload.timeout_ms = opts.timeout;
    }

    const apiUrl = `http://127.0.0.1:${opts.port}/api/vap/evaluate`;

    try {
        const response = await fetch(apiUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            const errData = await response.json().catch(() => ({ error: response.statusText }));
            console.error(`Evaluation Request Failed [HTTP ${response.status}]: ${errData.error || response.statusText}`);
            process.exit(1);
        }

        const data = await response.json();

        if (opts.json) {
            console.log(JSON.stringify(data, null, 2));
            process.exit(data.decision === "ACCEPT" ? 0 : 1);
        }

        console.log("=================================================");
        console.log("       VHL CIRCUIT EVALUATION REPORT             ");
        console.log("=================================================");
        console.log(`Target:       ${opts.file ? opts.file : `${opts.module}/${opts.circuit || `${opts.module}.tsx`}`}`);
        console.log(`Decision:     ${data.decision === "ACCEPT" ? " ACCEPT" : " REJECT"}`);
        console.log(`Status:       ${data.eval_status || (data.success ? "Success" : "Error")}`);
        console.log(`Timed Out:    ${data.timedOut ? "YES" : "NO"}`);

        if (data.metadata) {
            console.log("---------------- Metadata -----------------------");
            if (data.metadata.timeTakenMs) console.log(`Time Taken:   ${data.metadata.timeTakenMs}ms`);
            if (data.metadata.errorCount !== undefined) console.log(`Errors:       ${data.metadata.errorCount}`);
            if (data.metadata.warningCount !== undefined) console.log(`Warnings:     ${data.metadata.warningCount}`);
            if (data.metadata.circuitJsonCreated !== undefined) {
                console.log(`Circuit JSON: ${data.metadata.circuitJsonCreated ? "Created" : "None"}`);
            }
        }

        if (data.logs && data.logs.length > 0) {
            console.log("---------------- Log Highlights -----------------");
            // Show errors/warnings and last 15 lines
            const relevantLogs = data.logs.filter(l => 
                l.includes("error") || 
                l.includes("Error") || 
                l.includes("failed") || 
                l.includes("warn") || 
                l.includes("Circuit JSON") || 
                l.includes("Build")
            );
            const tailLogs = data.logs.slice(-15);
            const displayLogs = Array.from(new Set([...relevantLogs, ...tailLogs]));
            displayLogs.forEach(line => console.log(`  ${line}`));
        }

        console.log("=================================================");
        process.exit(data.decision === "ACCEPT" ? 0 : 1);

    } catch (fetchErr) {
        console.error(`Connection Error: Unable to reach VHL API server at ${apiUrl}: ${fetchErr.message}`);
        console.error("Ensure vhl-runtime-mosaic is running or specify --port <port>.");
        process.exit(2);
    }
}

main().catch(err => {
    console.error("Fatal Error:", err);
    process.exit(1);
});
