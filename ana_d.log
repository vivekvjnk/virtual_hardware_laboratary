o=".RT6 > .pin1" />\n   368\t      <trace from=".RT6 > .pin2" to="net.GND" />\n   369\t\n   370\t      <trace from="net.PULLUP" to=".R18 > .pin1" />\n   371\t      <trace from=".R18 > .pin2" to="net.GPIO2_R" />\n   372\t      <trace from="net.GPIO2_R" to=".RT7 > .pin1" />\n   373\t      <trace from=".RT7 > .pin2" to="net.GND" />\n   374\t\n   375\t      <trace from="net.PULLUP" to=".R19 > .pin1" />\n   376\t      <trace from=".R19 > .pin2" to="net.GPIO1_R" />\n   377\t      <trace from="net.GPIO1_R" to=".RT8 > .pin1" />\n   378\t      <trace from=".RT8 > .pin2" to="net.GND" />\n   379\t\n   380\t      {/* GPIO1 Filter Connections */}\n   381\t      <trace from="net.GPIO1_R" to=".R128 > .pin1" />\n   382\t      <trace from=".R128 > .pin2" to="net.GPIO1_C" />\n   383\t      <trace from="net.GPIO1_R" to=".C60 > .pin1" />\n   384\t      <trace from=".C60 > .pin2" to="net.GND" />\n   385\t      <trace from="net.GPIO1_R" to=".D3 > .pin1" />\n   386\t      <trace from="net.GND" to=".D3 > .pin2" />\n   387\t\n   388\t      {/* J4 Connections */}\n   389\t      <trace from="net.GPIO1_C" to=".J4 > .pin1" /> {/* Adjusted from pin2 to pin1 as per schematic/SCUD for GPIO1 */}\n   390\t      <trace from="net.GPIO2_R" to=".J4 > .pin4" />\n   391\t      <trace from="net.GPIO3_R" to=".J4 > .pin6" />\n   392\t      <trace from="net.GPIO4_R" to=".J4 > .pin8" />\n   393\t      <trace from="net.GPIO5_R" to=".J4 > .pin10" />\n   394\t      <trace from="net.GPIO6_R" to=".J4 > .pin12" />\n   395\t      <trace from="net.GPIO7_R" to=".J4 > .pin14" />\n   396\t      <trace from="net.GPIO8_R" to=".J4 > .pin16" />\n   397\t\n   398\t      {/* DNP R20 and C12 for RT8 channel (connected for completeness, but effectively DNP) */}\n   399\t      <trace from="net.GPIO1_R" to=".R20 > .pin1" />\n   400\t      <trace from="net.RT8 > .pin1" to=".R20 > .pin2" /> {/* Connects across RT8 */} \n   401\t\n   402\t      <trace from="net.GPIO1_R" to=".C12 > .pin1" />\n   403\t      <trace from="net.RT8 > .pin1