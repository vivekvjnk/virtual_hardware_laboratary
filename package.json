{
  "name": "virtual-hardware-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual Hardware Laboratory (VHL) – TypeScript-based MCP server for tscircuit-driven hardware design",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:vap": "tsx src/vap/vapIndex.ts",
    "start:ws": "tsx src/server/wsIndex.ts",
    "start:workspace": "tsx src/workspace/index.ts",
    "start:ana": "tsx src/mcp/ana/index.ts",
    "start:ui_snapshot": "tsx src/mcp/ui_snapshot/index.ts",
    "test": "vitest",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "clean": "rm -rf dist"
  },
 "pnpm": {
    "allowedBuildScripts": [
      "sharp",
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@types/archiver": "^7.0.0",
    "@types/http-proxy": "^1.17.17",
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "ky": "^1.7.4",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "react": "^19.2.3",
    "sharp": "^0.34.5",
    "tscircuit": "latest",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.12",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.8",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}