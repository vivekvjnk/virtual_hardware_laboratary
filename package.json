{
  "name": "virtual-hardware-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual Hardware Laboratory (VHL) – TypeScript-based MCP server for tscircuit-driven hardware design",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:vap": "tsx src/vap/vapIndex.ts",
    "start:ws": "tsx src/server/wsIndex.ts",
    "start:workspace": "tsx src/workspace/index.ts",
    "start:ana": "tsx src/mcp/ana/index.ts",
    "start:ui_snapshot": "tsx src/mcp/ui_snapshot/index.ts",
    "test": "vitest",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "clean": "rm -rf dist"
  },
  "pnpm": {
    "allowedBuildScripts": [
      "sharp",
      "esbuild",
      "sqlite3"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/archiver": "^8.0.0",
    "@types/http-proxy": "^1.17.17",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "ky": "^2.0.2",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "sharp": "^0.35.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tscircuit": "0.0.2017",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}