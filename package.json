{
  "name": "virtual-hardware-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual Hardware Laboratory (VHL) – TypeScript-based MCP server for tscircuit-driven hardware design",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:vap": "tsx src/vap/vapIndex.ts",
    "start:ws": "tsx src/server/wsIndex.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "minio": "^8.0.6",
    "react": "^19.2.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.8",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}