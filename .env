STUBS=false
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=vhl-storage

# --- Observability ---
# Set to "laminar" or "google_cloud" to enable tracing, "none" to disable.
OTEL_BACKEND=laminar
OTEL_SERVICE_NAME=virtual_hardware_lab

# Select which collector config profile to mount.
# Options: collector-laminar.yaml | collector-google-cloud.yaml
OTEL_COLLECTOR_CONFIG=collector-laminar.yaml

