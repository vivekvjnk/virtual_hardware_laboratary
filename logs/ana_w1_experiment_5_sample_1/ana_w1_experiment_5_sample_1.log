                             .pin2\\\" to=\\\"net.GND\\\" />\\n      <trace from=\\\".Q1 > .pin1\\\" to=\\\"net.NPNB\\\" /> {/* Base */}\\n      <trace from=\\\".Q1             
                             > .pin1\\\" to=\\\".U1 > .NPNB\\\" />\\n      <trace from=\\\".Q1 > .pin2\\\" to=\\\"net.LDOIN\\\" /> {/* Emitter */}\\n      <trace                
                             from=\\\".Q1 > .pin2\\\" to=\\\".U1 > .LDOIN\\\" />\\n\\n      {/* Decoupling Capacitors */}\\n      <capacitor name=\\\"C6\\\"                     
