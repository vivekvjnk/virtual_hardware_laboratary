     <capacitor name="C59" capacitance="0.1uF" footprint="0402" />\n      <capacitor name="C3" capacitance="0.1uF" footprint="0402" />\n      <capacitor name="C2" capacitance="1uF" footprint="0402" />\n      \n      <capacitor name="C57" capacitance="0.1uF" footprint="0402" />\n      <capacitor name="C58" capacitance="0.1uF" footprint="0402" />\n\n      <resistor name="R121" resistance="1k" footprint="0402" />\n      <jumper name="J6" footprint="pinheader_2" />\n\n      {/* Passives: Config Jumpers (DNP) */}\n      <resistor name="R21" resistance="0" footprint="0402" />\n      <resistor name="R22" resistance="0" footprint="0402" />\n      <resistor name="R25" resistance="0" footprint="0402" />\n      <resistor name="R26" resistance="0" footprint="0402" />\n      <resistor name="R23" resistance="0" footprint="0402" />\n      <resistor name="R24" resistance="0" footprint="0402" />\n      <resistor name="R27" resistance="0" footprint="0402" />\n      <resistor name="R28" resistance="0" footprint="0402" />\n\n      {/* Passives: Aux Measurement */}\n      <resistor name="R9" resistance="402" footprint="0402" />\n      <resistor name="R12" resistance="402" footprint="0402" />\n      <capacitor name="C10" capacitance="0.47uF" footprint="0603" />\n      <resistor name="R10" resistance="0" footprint="0402" />\n      <resistor name="R13" resistance="0" footprint="0402" />\n      <resistor name="R17" resistance="0" footprint="0402" />\n      <capacitor name="C11" capacitance="0.47uF" footprint="0603" />\n\n      {/* Passives: Temp Sense Pullups & Filter */}\n      <resistor name="R7" resistance="10k" footprint="0402" />\n      <resistor name="R8" resistance="10k" footprint="0402" />\n      <resistor name="R11" resistance="10k" footprint="0402" />\n      <resistor name="R14" resistance="10k" footprint="0402" />\n      <resistor name="R15" resistance="10k" footprint="0402" />\n      <resistor name="R16" resistance="10k" footprint="0402" />\n      <resistor name="R18" resistance="10k" footprint="0402" />\n      <resistor name="R19" resistance="10k" footprint="0402" />\n      \n      <resistor name="R128" resistance="1k" footprint="0402" />\n      <capacitor name="C60" capacitance="1uF" footprint="0402" />\n      <resistor name="R20" resistance="100k" footprint="0402" />\n      <capacitor name="C12" capacitance="0.1uF" footprint="0402" />\n\n      {/* Connectors */}\n      <pinheader name="J4" footprint="pinheader_2x8" />\n      <pinheader name="J5" footprint="pinheader_1x2" />\n      <pinheader name="J17" footprint="pinheader_2x5" />\n      <pinheader name="J18" footprint="pinheader_1x2" />\n      <pinheader name="J21" footprint="pinheader_1x2" />\n      <pinheader name="J1" footprint="pinheader_1x2" />\n      <pinheader name="J2" footprint="pinheader_1x2" />\n      <pinheader name="J3" footprint="pinheader_1x6" />\n\n      <resistor name="R119" resistance="100" footprint="0402" />\n      <resistor name="R123" resistance="0" footprint="0402" />\n\n      {/* --------------------------------------------------------- */}\n      {/* CONNECTIVITY                                              */}\n      {/* --------------------------------------------------------- */}\n\n      {/* U1 Power & Decoupling */}\n      <trace from=".U1 > .BAT" to="net.BAT_FILT" />\n      <trace from=".R5 > .pin1" to="net.PWR" />\n      <trace from=".R5 > .pin2" to="net.BAT_FILT" />\n      <trace from=".C5 > .pin1" to="net.BAT_FILT" />\n      <trace from=".C5 > .pin2" to="net.GND" />\n\n      <trace from=".U1 > .AVDD" to="net.AVDD" />\n      <trace from=".C6 > .pin1" to="net.AVDD" />\n      <trace from=".C6 > .pin2" to="net.GND" />\n\n      <trace from=".U1 > .CVDD" to="net.CVDD" />\n      <trace from=".C9 > .pin1" to="net.CVDD" />\n      <trace from=".C9 > .pin2" to="net.GND" />\n\n      <trace from=".U1 > .DVDD" to="net.DVDD" />\n      <trace from=".C7 > .pin1" to="net.DVDD" />\n      <trace from=".C7 > .pin2" to="net.GND" />\n      <trace from=".C8 > .pin1" to="net.DVDD" />\n      <trace from=".C8 > .pin2" to="net.GND" />\n\n      <trace from=".U1 > .TSREF" to="net.TSREF" />\n      <trace from=".C2 > .pin1" to="net.TSREF" />\n      <trace from=".C2 > .pin2" to="net.GND" />\n\n      <trace from=".U1 > .LDOIN" to="net.LDOIN" />\n      <trace from=".C59 > .pin1" to="net.LDOIN" />\n      <trace from=".C59 > .pin2" to="net.GND" />\n\n      <trace from=".U1 > .NEG5V" to="net.NEG5V" />\n      <trace from=".C3 > .pin1" to="net.NEG5V" />\n      <trace from=".C3 > .pin2" to="net.GND" />\n\n      <trace from=".U1 > .NPNB" to="net.NPNB" />\n      <trace from=".U1 > .REFHP" to="net.REFHP" />\n      \n      <trace from=".U1 > .AVSS" to="net.GND" />\n      <trace from=".U1 > .CVSS" to="net.GND" />\n      <trace from=".U1 > .DVSS" to="net.GND" />\n      <trace from=".U1 > .REFHM" to="net.GND" />\n      <trace from=".U1 > .PAD" to="net.GND" />\n\n      {/* NPN Supply */}\n      <trace from=".Q1 > .E" to="net.LDOIN" />\n      <trace from=".Q1 > .B" to="net.NPNB" />\n      <trace from=".Q1 > .C" to=".R3 > .pin2" />\n      <trace from=".R3 > .pin1" to=".R4 > .pin2" />\n      <trace from=".R4 > .pin1" to="net.PWR" />\n      <trace from=".C1 > .pin1" to=".Q1 > .C" />\n      <trace from=".C1 > .pin2" to="net.GND" />\n\n      {/* Power Indicator */}\n      <trace from=".D1 > .anode" to=".R121 > .pin2" />\n      <trace from=".R121 > .pin1" to=".J6 > .pin2" />\n      <trace from=".J6 > .pin1" to="net.CVDD" />\n      <trace from=".D1 > .cathode" to="net.GND" />\n\n      {/* Cell Inputs */}\n      <trace from=".U1 > .VC0" to="net.VC0" />\n      <trace from=".U1 > .VC1" to="net.VC1" />\n      <trace from=".U1 > .VC2" to="net.VC2" />\n      <trace from=".U1 > .VC3" to="net.VC3" />\n      <trace from=".U1 > .VC4" to="net.VC4" />\n      <trace from=".U1 > .VC5" to="net.VC5" />\n      <trace from=".U1 > .VC6" to="net.VC6" />\n      <trace from=".U1 > .VC7" to="net.VC7" />\n      <trace from=".U1 > .VC8" to="net.VC8" />\n      <trace from=".U1 > .VC9" to="net.VC9" />\n      <trace from=".U1 > .VC10" to="net.VC10" />\n      <trace from=".U1 > .VC11" to="net.VC11" />\n      <trace from=".U1 > .VC12" to="net.VC12" />\n      <trace from=".U1 > .VC13" to="net.VC13" />\n      <trace from=".U1 > .VC14" to="net.VC14" />\n      <trace from=".U1 > .VC15" to="net.VC15" />\n      <trace from=".U1 > .VC16" to="net.VC16" />\n\n      <trace from=".U1 > .CB0" to="net.CB0" />\n      <trace from=".U1 > .CB1" to="net.CB1" />\n      <trace from=".U1 > .CB2" to="net.CB2" />\n      <trace from=".U1 > .CB3" to="net.CB3" />\n      <trace from=".U1 > .CB4" to="net.CB4" />\n      <trace from=".U1 > .CB5" to="net.CB5" />\n      <trace from=".U1 > .CB6" to="net.CB6" />\n      <trace from=".U1 > .CB7" to="net.CB7" />\n      <trace from=".U1 > .CB8" to="net.CB8" />\n      <trace from=".U1 > .CB9" to="net.CB9" />\n      <trace from=".U1 > .CB10" to="net.CB10" />\n      <trace from=".U1 > .CB11" to="net.CB11" />\n      <trace from=".U1 > .CB12" to="net.CB12" />\n      <trace from=".U1 > .CB13" to="net.CB13" />\n      <trace from=".U1 > .CB14" to="net.CB14" />\n      <trace from=".U1 > .CB15" to="net.CB15" />\n      <trace from=".U1 > .CB16" to="net.CB16" />\n\n      {/* Config Jumpers */}\n      <trace from=".R25 > .pin1" to="net.CB12" /><trace from=".R25 > .pin2" to="net.CB13" />\n      <trace from=".R21 > .pin1" to="net.CB13" /><trace from=".R21 > .pin2" to="net.CB14" />\n      <trace from=".R26 > .pin1" to="net.CB14" /><trace from=".R26 > .pin2" to="net.CB15" />\n      <trace from=".R22 > .pin1" to="net.CB15" /><trace from=".R22 > .pin2" to="net.CB16" />\n\n      <trace from=".R27 > .pin1" to="net.VC12" /><trace from=".R27 > .pin2" to="net.VC13" />\n      <trace from=".R23 > .pin1" to="net.VC13" /><trace from=".R23 > .pin2" to="net.VC14" />\n      <trace from=".R28 > .pin1" to="net.VC14" /><trace from=".R28 > .pin2" to="net.VC15" />\n      <trace from=".R24 > .pin1" to="net.VC15" /><trace from=".R24 > .pin2" to="net.VC16" />\n\n      {/* Comms: Daisy Chain */}\n      <trace from=".U1 > .COMHP" to="net.COMHP" />\n      <trace from=".U1 > .COMHN" to="net.COMHN" />\n      <trace from=".U1 > .COMLP" to="net.COMLP" />\n      <trace from=".U1 > .COMLN" to="net.COMLN" />\n\n      {/* Comms: Local */}\n      <trace from=".U1 > .RX" to="net.RX" />\n      <trace from=".U1 > .TX" to="net.TX" />\n      <trace from=".U1 > .NFAULT" to="net.NFAULT" />\n\n      {/* Isolator U2 */}\n      <trace from=".U2 > .VCC1" to="net.USB2ANY_3.3V" />\n      <trace from=".U2 > .GND1" to="net.GND" /> {/* Assuming common GND for simplicity or isolated GND? SCUD says "GND is tied to CELL0... establishing reference for low-voltage side". But U2 is an isolator. Usually Side 1 is MCU GND, Side 2 is BMS GND. SCUD says "U2 Isolated side powered by USB2ANY_3.3V". I will assume a separate net for ISO GND is not explicitly defined in SCUD nets list, but standard practice implies it. However, I will stick to SCUD nets. If no ISO_GND is listed, I might have to leave it or use GND if the SCUD implies common ground (which defeats isolation). SCUD says "GND is tied to CELL0...". Let\'s look at J17. J17 has GND? J17-1 is likely GND. I will create a net ISO_GND for safety if not in SCUD, but SCUD is authoritative. SCUD says "J3 Pin 1: GND". J17 pinout not fully detailed for GND. I will assume Side 1 uses a net named "ISO_GND" implicitly or just leave it unconnected if not specified. Wait, SCUD says "GND is tied to CELL0... establishing the reference potential for the low-voltage side." This implies the BMS side is the "low voltage side" relative to the stack? No, BMS is High Voltage. MCU is Low Voltage.\n      Actually, let\'s look at U2 connections again.\n      Side 1 (MCU): USB2ANY_3.3V.\n      Side 2 (BMS): CVDD_CO.\n      I will connect Side 2 GND to net.GND (BMS Ground).\n      Side 1 GND needs a net. I\'ll call it "GND_ISO".\n      */}\n      <net name="GND_ISO" />\n      <trace from=".U2 > .GND1" to="net.GND_ISO" />\n      <trace from=".U2 > .GND2" to="net.GND" />\n      <trace from=".U2 > .VCC2" to="net.CVDD_CO" />\n      \n      <trace from=".C57 > .pin1" to="net.USB2ANY_3.3V" />\n      <trace from=".C57 > .pin2" to="net.GND_ISO" />\n      <trace from=".C58 > .pin1" to="net.CVDD_CO" />\n      <trace from=".C58 > .pin2" to="net.GND" />\n\n      <trace from=".J18 > .pin1" to="net.CVDD" />\n      <trace from=".J18 > .pin2" to="net.CVDD_CO" />\n\n      {/* U2 Signals */}\n      {/* TX Path: MCU -> BMS */}\n      <trace from=".J17 > .pin7" to="net.USB2ANY_TX_3.3" />\n      <trace from=".U2 > .INB" to="net.USB2ANY_TX_3.3" />\n      <trace from=".U2 > .OUTB" to="net.RX_CO" />\n      <trace from=".J21 > .pin1" to="net.RX_CO" />\n      <trace from=".J21 > .pin2" to="net.RX" />\n\n      {/* RX Path: BMS -> MCU */}\n      <trace from=".U1 > .TX" to=".U2 > .INC" />\n      <trace from=".U2 > .OUTC" to="net.USB2ANY_RX_3.3" />\n      <trace from=".J17 > .pin8" to="net.USB2ANY_RX_3.3" />\n\n      {/* Fault Path: BMS -> MCU */}\n      <trace from=".U1 > .NFAULT" to=".J2 > .pin1" />\n      <trace from=".J2 > .pin2" to="net.NF_J" />\n      <trace from=".U2 > .IND" to="net.NF_J" />\n      <trace from=".U2 > .OUTD" to="net.NFAULT_C" />\n      <trace from=".J17 > .pin3" to="net.NFAULT_C" />\n\n      {/* U2 INA/OUTA */}\n      <trace from=".U2 > .INA" to=".R123 > .pin1" />\n      <trace from=".R123 > .pin2" to="net.GND_ISO" />\n\n      {/* Direct UART J3 */}\n      <trace from=".J3 > .pin1" to="net.GND" />\n      <trace from=".J3 > .pin2" to="net.NFAULT" />\n      <trace from=".J3 > .pin3" to="net.RX_C" />\n      <trace from=".J3 > .pin4" to="net.TX" />\n      \n      <trace from=".R119 > .pin1" to="net.RX_C" />\n      <trace from=".R119 > .pin2" to=".J1 > .pin1" />\n      <trace from=".J1 > .pin2" to="net.RX" />\n\n      {/* Aux Measurements */}\n      <trace from=".U1 > .BBP" to="net.BBP" />\n      <trace from=".U1 > .BBN" to="net.BBN" />\n\n      {/* Path 1: Bus Bar (DNP) */}\n      <trace from=".R9 > .pin1" to="net.BBP_CELL" />\n      <trace from=".R9 > .pin2" to=".R10 > .pin1" />\n      <trace from=".R10 > .pin2" to="net.BBP" />\n      \n      <trace from=".R12 > .pin1" to="net.BBN_CELL" />\n      <trace from=".R12 > .pin2" to=".R13 > .pin1" />\n      <trace from=".R13 > .pin2" to="net.BBN" />\n      \n      <trace from=".C10 > .pin1" to=".R10 > .pin1" />\n      <trace from=".C10 > .pin2" to=".R13 > .pin1" />\n\n      {/* Path 2: Current Sense (Active) */}\n      <trace from="net.SRP_S" to="net.BBP" />\n      <trace from="net.SRN_S" to="net.BBN" />\n      <trace from=".C11 > .pin1" to="net.BBP" />\n      <trace from=".C11 > .pin2" to="net.BBN" />\n      <trace from=".R17 > .pin1" to="net.BBP" />\n      <trace from=".R17 > .pin2" to="net.BBN" />\n\n      {/* Temp Sense */}\n      <trace from=".J5 > .pin1" to="net.TSREF" />\n      <trace from=".J5 > .pin2" to="net.PULLUP" />\n\n      {/* Pullups */}\n      <trace from="net.PULLUP" to=".R7 > .pin1" />\n      <trace from="net.PULLUP" to=".R8 > .pin1" />\n      <trace from="net.PULLUP" to=".R11 > .pin1" />\n      <trace from="net.PULLUP" to=".R14 > .pin1" />\n      <trace from="net.PULLUP" to=".R15 > .pin1" />\n      <trace from="net.PULLUP" to=".R16 > .pin1" />\n      <trace from="net.PULLUP" to=".R18 > .pin1" />\n      <trace from="net.PULLUP" to=".R19 > .pin1" />\n\n      {/* Dividers */}\n      <trace from=".R7 > .pin2" to="net.GPIO8_R" />\n      <trace from=".R8 > .pin2" to="net.GPIO7_R" />\n      <trace from=".R11 > .pin2" to="net.GPIO6_R" />\n      <trace from=".R14 > .pin2" to="net.GPIO5_R" />\n      <trace from=".R15 > .pin2" to="net.GPIO4_R" />\n      <trace from=".R16 > .pin2" to="net.GPIO3_R" />\n      <trace from=".R18 > .pin2" to="net.GPIO2_R" />\n      <trace from=".R19 > .pin2" to="net.GPIO1_R" />\n\n      {/* Thermistors */}\n      <trace from=".RT8 > .pin1" to="net.GPIO8_R" /><trace from=".RT8 > .pin2" to="net.GND" />\n      <trace from=".RT7 > .pin1" to="net.GPIO7_R" /><trace from=".RT7 > .pin2" to="net.GND" />\n      <trace from=".RT6 > .pin1" to="net.GPIO6_R" /><trace from=".RT6 > .pin2" to="net.GND" />\n      <trace from=".RT5 > .pin1" to="net.GPIO5_R" /><trace from=".RT5 > .pin2" to="net.GND" />\n      <trace from=".RT4 > .pin1" to="net.GPIO4_R" /><trace from=".RT4 > .pin2" to="net.GND" />\n      <trace from=".RT3 > .pin1" to="net.GPIO3_R" /><trace from=".RT3 > .pin2" to="net.GND" />\n      <trace from=".RT2 > .pin1" to="net.GPIO2_R" /><trace from=".RT2 > .pin2" to="net.GND" />\n      <trace from=".RT1 > .pin1" to="net.GPIO1_R" /><trace from=".RT1 > .pin2" to="net.GND" />\n\n      {/* J4 Connections */}\n      {/* J4 Pinout: Odd pins to GPIOx, Even pins to GPIOx_R (or C) */}\n      {/* SCUD: "GPIOx connects directly to GPIOx_R when the jumper is placed" */}\n      {/* Assuming J4 is a 2x8 header where pairs are (1,2), (3,4)... for jumpers */}\n      {/* Let\'s assume Pin 1=GPIO8, Pin 2=GPIO8_R... down to Pin 15=GPIO1, Pin 16=GPIO1_C */}\n      {/* Wait, SCUD says "Channels 2-8: GPIOx connects directly to GPIOx_R" */}\n      {/* "Channel 1: GPIO1_R -> R128 -> GPIO1_C -> J4 Pin 2" */}\n      {/* So J4 Pin 2 is GPIO1_C. J4 Pin 1 is GPIO1. */}\n      {/* Let\'s map J4:\n          Pin 1: GPIO1, Pin 2: GPIO1_C\n          Pin 3: GPIO2, Pin 4: GPIO2_R\n          ...\n          Pin 15: GPIO8, Pin 16: GPIO8_R\n      */}\n      \n      <trace from=".J4 > .pin1" to="net.GPIO1" />\n      <trace from=".J4 > .pin2" to="net.GPIO1_C" />\n      \n      <trace from=".J4 > .pin3" to="net.GPIO2" />\n      <trace from=".J4 > .pin4" to="net.GPIO2_R" />\n      \n      <trace from=".J4 > .pin5" to="net.GPIO3" />\n      <trace from=".J4 > .pin6" to="net.GPIO3_R" />\n      \n      <trace from=".J4 > .pin7" to="net.GPIO4" />\n      <trace from=".J4 > .pin8" to="net.GPIO4_R" />\n      \n      <trace from=".J4 > .pin9" to="net.GPIO5" />\n      <trace from=".J4 > .pin10" to="net.GPIO5_R" />\n      \n      <trace from=".J4 > .pin11" to="net.GPIO6" />\n      <trace from=".J4 > .pin12" to="net.GPIO6_R" />\n      \n      <trace from=".J4 > .pin13" to="net.GPIO7" />\n      <trace from=".J4 > .pin14" to="net.GPIO7_R" />\n      \n      <trace from=".J4 > .pin15" to="net.GPIO8" />\n      <trace from=".J4 > .pin16" to="net.GPIO8_R" />\n\n      {/* U1 GPIO Connections */}\n      <trace from=".U1 > .GPIO1" to="net.GPIO1" />\n      <trace from=".U1 > .GPIO2" to="net.GPIO2" />\n      <trace from=".U1 > .GPIO3" to="net.GPIO3" />\n      <trace from=".U1 > .GPIO4" to="net.GPIO4" />\n      <trace from=".U1 > .GPIO5" to="net.GPIO5" />\n      <trace from=".U1 > .GPIO6" to="net.GPIO6" />\n      <trace from=".U1 > .GPIO7" to="net.GPIO7" />\n      <trace from=".U1 > .GPIO8" to="net.GPIO8" />\n\n      {/* GPIO1 Filter */}\n      <trace from="net.GPIO1_R" to=".R128 > .pin1" />\n      <trace from=".R128 > .pin2" to="net.GPIO1_C" />\n      <trace from=".C60 > .pin1" to="net.GPIO1_R" />\n      <trace from=".C60 > .pin2" to="net.GND" />\n      <trace from=".D3 > .cathode" to="net.GPIO1_R" />\n      <trace from=".D3 > .anode" to="net.GND" />\n\n      {/* DNP Components on RT8 */}\n      <trace from=".R20 > .pin1" to="net.GPIO8_R" />\n      <trace from=".R20 > .pin2" to="net.GND" />\n      <trace from=".C12 > .pin1" to="net.GPIO8_R" />\n      <trace from=".C12 > .pin2" to="net.GND" />\n\n    </board>\n  )\n}\n', 'path': 'ana/output/bq79616_eval.tsx'}}, 'thoughtSignature': 'c2tpcF90aG91Z2h0X3NpZ25hdHVyZV92YWxpZGF0b3I='}]}, {'parts': [{'function_response': {'name': 'file_editor', 'response': {'content': '[An error occurred during execution.]\nInvalid `path` parameter: ana/output/bq79616_eval.tsx. The path should be an absolute path, starting with `/`.'}}}]}], 'system_instruction': {'parts': [{'text': '### **SYSTEM PROMPT — ANA-W1 (Circuit Synthesis Worker)**\n\nYou are **ANA-W1**, a **narrow, atomic circuit synthesis worker**.\n\nYou do **not** plan, interpret intent, arbitrate correctness, or manage workflow.\nYou execute **one task only**, then terminate.\n\n---\n\n## 1. Your Responsibility\n\nYour sole responsibility is to:\n\n> **Generate a complete and valid `tscircuit` `.tsx` circuit file from the provided SCUD document.**\n\nYou must:\n\n* faithfully translate the circuit described in SCUD into code\n* use only components available in the VHL Component Library\n* express all connectivity explicitly and accurately\n\nOnce the circuit code is generated, **your task is complete**.\n\nYou do **not**:\n\n* evaluate the circuit\n* validate correctness\n* reason about acceptance\n* retry or revise\n* explain errors\n* modify intent\n\n---\n\n## 2. Your Inputs\n\nYou are given:\n\n### A. SCUD Document (Primary Source of Truth)\n\nFrom SCUD, you must use **only** the following sections:\n\n* **Components Inventory**\n* **Connectivity & Signal Flow**\n* **VHL Component Library References**\n\nTreat SCUD as:\n\n* complete\n* authoritative\n* already interpreted\n\nYou must **not**:\n\n* reinterpret SCUD\n* resolve ambiguities\n* invent intent\n* modify or annotate SCUD\n\nIf SCUD is internally inconsistent, still produce the best possible circuit **as described**.\n\n---\n\n### B. VHL Component Library (Availability Constraint)\n\nYou may use **only components that are available** in the VHL Component Library.\n\nYou must:\n\n* instantiate/import components exactly as they exist in the library. Paths are managed by VHL system. Use relative imports\n  * Any component listed under "VHL Component Library References" in SCUD is guaranteed to be available\n  * you can import them directly by name\n  * you shoud **not** check for availability or existence of components in local filesystem. SCUD is authoritative, and you can assume all listed components are available\n* respect pin names and pin mappings as defined by the library\n\nYou must **not**:\n\n* invent components\n* request new components\n* assume missing parts\n\n### C. Raw schematic images (Secondary Reference)\nYou may refer to raw schematic images **only** for visual clarification of connectivity.\nSCUD may be ambiguous or incomplete; images can help resolve that.\nYou must **not** rely on images as primary source of truth.\n\n---\n\n## 3. Your Skills (How to Use Them)\n\nYou possess the following skills.\nThey are **tools**, not content.\n\n### A. tscircuit Operation Manual\n\nUse this skill to:\n\n* understand how to declare components\n* define nets and connections\n* structure a valid `.tsx` circuit file\n* follow correct `tscircuit` syntax and conventions\n\nYou should rely on this skill whenever you need to:\n\n* recall syntax\n* confirm how connections are expressed\n* structure the file correctly\n\n---\n\n### B. BFS-DC Circuit Building Strategy\n\nUse this strategy to:\n\n* incrementally build the circuit\n* start from core components\n* expand connections breadth-first\n* avoid dangling or implicit connections\n\nYou must:\n\n* construct the circuit step by step\n* ensure all connections described in SCUD are represented\n* avoid skipping intermediate wiring logic\n\n---\n\n## 4. Output Requirements\n\nYou must produce:\n\n* **Exactly one `.tsx` file**\n* Containing:\n\n  * all component instantiations\n  * all nets\n  * all connections required by SCUD\n\nThe output must be:\n\n* complete\n* syntactically valid\n* self-contained\n\nDo **not**:\n\n* include explanations\n* include comments unrelated to the circuit\n* include analysis or reasoning text\n* include multiple variants\n\nYour final output must be **only the `.tsx` circuit code**.\n\n---\n\n## 5. Operational Constraints (Very Important)\n\n* You are **not aware** of system phases.\n* You are **not aware** of arbitration or VAP.\n* You are **not aware** of retries or failures.\n* You will **not be invoked again** in this run.\n\nAssume:\n\n* intent is already fixed\n* your output will be consumed by another system\n* correctness will be judged externally\n\nYour job is **construction only**.\n\nOnce the circuit is produced, **stop**.\n\n<REPO_CONTEXT>\nThe following information has been included based on several files defined in user\'s repository.\nPlease follow them while working.\n\n\n[BEGIN context from [bfs-dc.md]]\n# **BFS-DC — Breadth-First Search with Degree Centrality**\n\n---\n\n## **Skill ID**\n\n`ANA-SKILL-BFS-DC`\n\n---\n\n## **Purpose**\n\nGuide ANA to **build and refine a circuit coherently across multiple agentic iterations** by:\n\n* Starting from **structurally important components or nets**\n* Expanding connectivity **breadth-first**\n* Growing the circuit **incrementally**, without destabilizing earlier structure\n* Strictly **do not** finish circuit building in one agentic iteration. Follow multiple passes.\nThis skill exists to control *how* ANA thinks, not *what* ANA computes.\n\n---\n\n## **Core Intuition**\n\n> **Some parts of a circuit matter more to global structure than others.\n> Start there, then expand outward gradually.**\n\n* “Degree Centrality” is used **qualitatively**, not numerically\n* “Breadth-First Search” describes **expansion style**, not traversal code\n\n---\n\n## **Mental Model (Lightweight)**\n\nANA maintains a **rough internal picture** of the circuit as it evolves:\n\n* Which components/nets are **structural anchors**\n* Which parts are **adjacent** to those anchors\n* Which parts are still **peripheral or undecided**\n\nThis picture is:\n\n* incomplete\n* approximate\n* continuously refined\n* never formalized as data structures\n\n---\n\n## **What “Degree Centrality” Means Here**\n\nANA uses *intuition*, not calculation.\n\nHigh-centrality elements are those that:\n\n* connect to many other things\n* define domains or boundaries\n* propagate constraints widely\n\nTypical examples:\n\n* Primary ICs\n* Power and ground rails\n* Shared buses\n* Isolation boundaries\n\nLow-centrality elements:\n\n* decoupling caps\n* pull-ups / pull-downs\n* EMI / termination parts\n\n---\n\n## **Skill Behavior Across Iterations**\n\n### **1. Initial Anchoring**\n\nAt the beginning of circuit construction, ANA:\n\n* Identifies a **small set of structurally important anchors**\n* Treats these as the **starting frontier**\n* Avoids deep detail elsewhere\n\nThis choice is **sticky** — it does not change lightly.\n\n---\n\n### **2. Breadth-First Expansion**\n\nANA expands outward from the anchors by:\n\n* Connecting **adjacent components or nets**\n* Handling one “layer” of proximity at a time\n* Prioritizing **interfaces and shared nets** over fine detail\n\nANA deliberately avoids:\n\n* finishing one IC completely in isolation\n* diving into secondary conditioning networks early\n\n---\n\n### **3. Incremental Graph Growth (Across Iterations)**\n\nAcross agentic iterations:\n\n* New components or connections are **added around the existing structure**\n* Earlier anchors remain stable reference points\n* The circuit “grows” rather than being reshaped wholesale\n\nImportantly:\n\n* ANA does **not** rebuild its mental model from scratch each iteration\n* Past structure constrains future reasoning\n\n---\n\n### **4. Late Peripheral Attachment**\n\nOnly after the main structure is stable does ANA:\n\n* attach low-impact components\n* refine conditioning networks\n* complete secondary details\n\nThese changes are assumed to have **local impact only**.\n\n---\n\n## **Interaction with Evaluation Failures**\n\nWhen evaluation fails:\n\n* ANA interprets errors relative to **where it is in the expansion**\n* Recent additions are questioned first\n* Core anchors are reconsidered **only if failure clearly implicates them**\n\nBFS-DC discourages global rewrites in response to local errors.\n\n---\n\n## **Operational Constraints**\n\nThis skill **must**:\n\n* respect SCUD as the source of intent\n* tolerate ambiguity without forcing resolution\n* preserve continuity across retries\n\nThis skill **must not**:\n\n* enforce strict ordering rules\n* require numerical scoring\n* behave like a fixed algorithm\n\n---\n\n## **Explicit Non-Goals**\n\nThis skill does **not**:\n\n* guarantee correctness\n* optimize performance\n* compute graph metrics\n* ensure convergence\n\nIt guarantees **reasoning stability**, not success.\n\n\n[END Context]\n\n[BEGIN context from [tscircuit_operation_manual.md]]\n# `tscircuit` Operational Guide\n\n## **Skill ID**\n\n`ANA-SKILL-TSCIRCUIT-OPERATION-GUIDE`\n\n## Circuit Assembly, Modules & Connectivity\n\n---\n\n## Overview\n\nThis guide describes **how to assemble circuits using `tscircuit`** by:\n\n* instantiating existing components\n* organizing them into modules\n* arranging schematic and PCB layouts\n* defining connectivity using nets and traces\n\nIt assumes that **all components referenced already exist** and are importable.\n\n---\n\n## 1. Circuit Structure\n\n### Root Container\n\nEvery circuit must be wrapped in a `<board />` element.\n\n```tsx\n<board width="100mm" height="80mm">\n  {/* circuit contents */}\n</board>\n```\n\n* `<board />` is the root of schematic and PCB generation\n* All components, nets, groups, and traces must be children of `<board />`\n\n---\n\n## 2. Using Existing Components\n\n### A. Built-in Primitives\n\n`tscircuit` provides globally available primitives that **do not require imports**.\n\nCommon examples:\n\n* `<resistor />`\n* `<capacitor />`\n* `<inductor />`\n* `<diode />`\n* `<led />`\n* `<jumper />`\n* `<pinheader />`\n\n#### Required Props for Passives\n\n| Element         | Required Props                     |\n| --------------- | ---------------------------------- |\n| `<resistor />`  | `name`, `resistance`, `footprint`  |\n| `<capacitor />` | `name`, `capacitance`, `footprint` |\n| `<inductor />`  | `name`, `inductance`, `footprint`  |\n| `<led />`       | `name`, `color`, `footprint`       |\n\nExample:\n\n```tsx\n<resistor\n  name="R1"\n  resistance="10k"\n  footprint="0603"\n/>\n```\n\n---\n\n### B. Imported Components\n\nComponents defined elsewhere (e.g., ICs or reusable blocks) may be imported and instantiated.\n\n```tsx\nimport { ControllerIC } from "./lib/ControllerIC"\n\n<ControllerIC name="U1" />\n```\n\n* Imported components are treated as black boxes\n* Pin names must be used exactly as exposed by the component\n\n---\n\n## 3. Nets\n\n### Declaring Nets\n\nNamed nets are used for shared electrical nodes.\n\n```tsx\n<net name="VCC" />\n<net name="GND" />\n```\n\n* Nets should be declared near the top of the `<board />`\n* Nets may be referenced anywhere within the board\n\n---\n\n### Connecting to Nets\n\nPins may be connected directly to nets.\n\n```tsx\n<trace from=".U1 > .VDD" to="net.VCC" />\n<trace from=".U1 > .GND" to="net.GND" />\n```\n\n---\n\n## 4. Connectivity\n\n### A. Point-to-Point Traces\n\nUse `<trace />` to connect two pins.\n\n```tsx\n<trace from=".U1 > .TX" to=".R1 > .pin1" />\n```\n\n* `from` and `to` use CSS-like selectors\n* Pin identifiers depend on the component definition\n\n---\n\n### B. Mixed Connectivity\n\nBoth nets and direct traces may coexist.\n\n```tsx\n<trace from=".C1 > .pin1" to="net.VCC" />\n<trace from=".C1 > .pin2" to="net.GND" />\n```\n\n---\n\n## 5. Modular Organization with `<group />`\n\n### Purpose\n\n`<group />` is a container for organizing related components and traces.\n\nIt may be used to:\n\n* cluster functionally related elements\n* simplify layout\n* move multiple elements together\n\n---\n\n### Auto-Layout Support\n\n`<group />` supports automatic layout for schematic and PCB.\n\n#### Schematic Layout Props\n\n* `schFlex`\n* `schFlexDirection="row" | "column"`\n* `schGap`\n\n#### PCB Layout Props\n\n* `pcbGrid`\n* `pcbGridCols`\n* `pcbGridGap`\n\n---\n\n### Example: Power Input Block\n\n```tsx\n<group\n  schFlex\n  schFlexDirection="row"\n  schGap="2mm"\n  pcbGrid\n  pcbGridCols={2}\n  pcbGridGap="1mm"\n>\n  <resistor name="R_Fuse" resistance="10" footprint="0603" />\n  <capacitor name="C_Bulk" capacitance="100uF" footprint="1206" />\n\n  <trace from=".R_Fuse > .pin2" to=".C_Bulk > .pos" />\n</group>\n```\n\n---\n\n## 6. Placement\n\n### Manual Placement\n\nComponents or groups may be positioned explicitly.\n\n* Schematic: `schX`, `schY`\n* PCB: `pcbX`, `pcbY`\n\n```tsx\n<capacitor\n  name="C1"\n  capacitance="100nF"\n  footprint="0402"\n  schX={10}\n  schY={5}\n  pcbX={12}\n  pcbY={8}\n/>\n```\n\n---\n\n### Placement Strategy\n\n* Manual coordinates are typically used at **top-level**\n* Auto-layout is preferred inside dense groups\n\n---\n\n## 7. Canonical Assembly Example\n\n```tsx\nimport { ControllerIC } from "./lib/ControllerIC"\n\nexport default () => {\n  return (\n    <board width="100mm" height="80mm">\n      <net name="VCC" />\n      <net name="GND" />\n\n      <ControllerIC name="U1" />\n\n      <capacitor\n        name="C_Decouple"\n        capacitance="100nF"\n        footprint="0402"\n      />\n\n      <trace from=".U1 > .VDD" to="net.VCC" />\n      <trace from=".U1 > .GND" to="net.GND" />\n      <trace from=".C_Decouple > .pin1" to="net.VCC" />\n      <trace from=".C_Decouple > .pin2" to="net.GND" />\n    </board>\n  )\n}\n```\n\n---\n\n## 8. Built-in Elements Reference\n\n| Element                           | Description               |\n| --------------------------------- | ------------------------- |\n| `<board />`                       | Root container            |\n| `<net />`                         | Named electrical node     |\n| `<trace />`                       | Electrical connection     |\n| `<resistor />`                    | Passive resistor          |\n| `<capacitor />`                   | Passive capacitor         |\n| `<inductor />`                    | Passive inductor          |\n| `<diode />`                       | Diode                     |\n| `<led />`                         | LED                       |\n| `<jumper />` / `<solderjumper />` | Configuration links       |\n| `<pinheader />`                   | Connector                 |\n| `<group />`                       | Layout container          |\n| `<subcircuit />`                  | Isolated functional block |\n| `<via />`                         | PCB via                   |\n| `<testpoint />`                   | Measurement access        |\n| `<hole />`                        | Mechanical hole           |\n\n\n[END Context]\n\n</REPO_CONTEXT>'}]}, 'tools': [{'function_declarations': [{'name': 'terminal', 'description': 'Execute a bash command in the terminal within a persistent shell session.\n\n\n### Command Execution\n* One command at a time: You can only execute one bash command at a time. If you need to run multiple commands sequentially, use `&&` or `;` to chain them together.\n* Persistent session: Commands execute in a persistent shell session where environment variables, virtual environments, and working directory persist between commands.\n* Soft timeout: Commands have a soft timeout of 10 seconds, once that\'s reached, you have the option to continue or interrupt the command (see section below for details)\n* Shell options: Do NOT use `set -e`, `set -eu`, or `set -euo pipefail` in shell scripts or commands in this environment. The runtime may not support them and can cause unusable shell sessions. If you want to run multi-line bash commands, write the commands to a file and then run it, instead.\n\n### Long-running Commands\n* For commands that may run indefinitely, run them in the background and redirect output to a file, e.g. `python3 app.py > server.log 2>&1 &`.\n* For commands that may run for a long time (e.g. installation or testing commands), or commands that run for a fixed amount of time (e.g. sleep), you should set the "timeout" parameter of your function call to an appropriate value.\n* If a bash command returns exit code `-1`, this means the process hit the soft timeout and is not yet finished. By setting `is_input` to `true`, you can:\n  - Send empty `command` to retrieve additional logs\n  - Send text (set `command` to the text) to STDIN of the running process\n  - Send control commands like `C-c` (Ctrl+C), `C-d` (Ctrl+D), or `C-z` (Ctrl+Z) to interrupt the process\n  - If you do C-c, you can re-start the process with a longer "timeout" parameter to let it run to completion\n\n### Best Practices\n* Directory verification: Before creating new directories or files, first verify the parent directory exists and is the correct location.\n* Directory management: Try to maintain working directory by using absolute paths and avoiding excessive use of `cd`.\n\n### Output Handling\n* Output truncation: If the output exceeds a maximum length, it will be truncated before being returned.\n\n### Terminal Reset\n* Terminal reset: If the terminal becomes unresponsive, you can set the "reset" parameter to `true` to create a new terminal session. This will terminate the current session and start fresh.\n* Warning: Resetting the terminal will lose all previously set environment variables, working directory changes, and any running processes. Use this only when the terminal stops responding to commands.\n', 'parameters': {'type': 'object', 'properties': {'command': {'type': 'string', 'description': 'The bash command to execute. Can be empty string to view additional logs when previous exit code is `-1`. Can be `C-c` (Ctrl+C) to interrupt the currently running process. Note: You can only execute one bash command at a time. If you need to run multiple commands sequentially, you can use `&&` or `;` to chain them together.'}, 'is_input': {'type': 'boolean', 'description': 'If True, the command is an input to the running process. If False, the command is a bash command to be executed in the terminal. Default is False.'}, 'timeout': {'type': 'number', 'description': 'Optional. Sets a maximum time limit (in seconds) for running the command. If the command takes longer than this limit, you’ll be asked whether to continue or stop it. If you don’t set a value, the command will instead pause and ask for confirmation when it produces no new output for 30 seconds. Use a higher value if the command is expected to take a long time (like installation or testing), or if it has a known fixed durat