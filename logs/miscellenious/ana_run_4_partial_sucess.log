03RB.tsx\\"\\n\\nexport default () => (\\n  <board width=\\"150mm\\" height=\\"100mm\\">\\n    {/* Nets */}\\n    <net name=\\"GND\\" />\\n    <net name=\\"PWR\\" />\\n    <net name=\\"BAT\\" />\\n    <net name=\\"AVDD\\" />\\n    <net name=\\"CVDD\\" />\\n    <net name=\\"DVDD\\" />\\n    <net name=\\"TSREF\\" />\\n    <net name=\\"LDOIN\\" />\\n    <net name=\\"NPNB\\" />\\n    <net name=\\"NEG5V\\" />\\n    <net name=\\"REFHP\\" />\\n    <net name=\\"BBP\\" />\\n    <net name=\\"BBN\\" />\\n    <net name=\\"RX\\" />\\n    <net name=\\"TX\\" />\\n    <net name=\\"NFAULT\\" />\\n    <net name=\\"USB2ANY_3.3V\\" />\\n    <net name=\\"CVDD_CO\\" />\\n    <net name=\\"PULLUP\\" />\\n    <net name=\\"BBP_CELL\\" />\\n    <net name=\\"BBN_CELL\\" />\\n    <net name=\\"SRP_S\\" />\\n    <net name=\\"SRN_S\\" />\\n    <net name=\\"GPIO1_R\\" />\\n    <net name=\\"GPIO1_C\\" />\\n    <net name=\\"GPIO2_R\\" />\\n    <net name=\\"GPIO3_R\\" />\\n    <net name=\\"GPIO4_R\\" />\\n    <net name=\\"GPIO5_R\\" />\\n    <net name=\\"GPIO6_R\\" />\\n    <net name=\\"GPIO7_R\\" />\\n    <net name=\\"GPIO8_R\\" />\\n    <net name=\\"USB2ANY_TX_3.3\\" />\\n    <net name=\\"RX_CO\\" />\\n    <net name=\\"USB2ANY_RX_3.3\\" />\\n    <net name=\\"NF_J\\" />\\n    <net name=\\"NFAULT_C\\" />\\n    <net name=\\"RX_C\\" />\\n\\n    {/* Components */}\\n    <BQ79616PAPR name=\\"U1\\" />\\n    <ISO7342FCQDWRQ1 name=\\"U2\\" />\\n    <MMBT3904LT1G name=\\"Q1\\" />\\n    <A_150060GS75000 name=\\"D1\\" />\\n    <BZX84C24 name=\\"D3\\" />\\n\\n    {/* Thermistors */}\\n    <NCP18XH103F03RB name=\\"RT1\\" />\\n    <NCP18XH103F03RB name=\\"RT2\\" />\\n    <NCP18XH103F03RB name=\\"RT3\\" />\\n    <NCP18XH103F03RB name=\\"RT4\\" />\\n    <NCP18XH103F03RB name=\\"RT5\\" />\\n    <NCP18XH103F03RB name=\\"RT6\\" />\\n    <NCP18XH103F03RB name=\\"RT7\\" />\\n    <NCP18XH103F03RB name=\\"RT8\\" />\\n\\n    {/* Passives - Power/Decoupling */}\\n    <resistor name=\\"R5\\" resistance=\\"30\\" footprint=\\"0