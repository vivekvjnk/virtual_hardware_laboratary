 \"RT4\", gpio: \"GPIO4\", net: \"GPIO4_R\" },\n   113\t        { r: \"R15\", rt: \"RT5\", gpio: \"GPIO5\", net: \"GPIO5_R\" },\n   114\t        { r: \"R16\", rt: \"RT6\", gpio: \"GPIO6\", net: \"GPIO6_R\" },\n   115\t        { r: \"R18\", rt: \"RT7\", gpio: \"GPIO7\", net: \"GPIO7_R\" },\n   116\t        { r: \"R19\", rt: \"RT8\", gpio: \"GPIO8\", net: \"GPIO8_R\" },\n   117\t      ].map((item) => (\n   118\t        <group key={item.gpio}>\n   119\t          <resistor name={item.r} resistance=\"10k\" footprint=\"0603\" />\n   120\t          <NCP18XH103F03RB name={item.rt} />\n   121\t          <trace from=\"net.PULLUP\" to={`.${item.r} > .pin1`} />\n   122\t          <trace from={`.${item.r} > .pin2`} to={`.${item.rt} > .pin1`} />\n   123\t          <trace from={`.${item.rt} > .pin2`} to=\"net.GND\" />\n   124\t          {/* Direct connection to U1 for simplicity, assuming J4 jumpers are closed */}\n   125\t          <trace from={`.${item.r} > .pin2`} to={`.U1 > .${item.gpio}`} />\n   126\t        </group>\n   127\t      ))}\n   128\t      <trace from=\"net.GPIO1_C\" to=\".U1 > .GPIO1\" />\n   129\t    </group>\n   130\t\n   131\t    {/* Communication Interface */}\n   132\t    <group name=\"Communication\">\n   133\t      <ISO7342FCQDWRQ1 name=\"U2\" />\n   134\t      <capacitor name=\"C57\" capacitance=\"0.1uF\" footprint=\"0603\" />\n   135\t      <capacitor name=\"C58\" capacitance=\"0.1uF\" footprint=\"0603\" />\n   136\t      \n   137\t      <net name=\"USB2ANY_3.3V\" />\n   138\t      <net name=\"CVDD_CO\" />\n   139\t      <net name=\"RX_CO\" />\n   140\t      <net name=\"NFAULT_C\" />\n   141\t\n   142\t      <trace from=\"net.USB2ANY_3.3V\" to=\".U2 > .VCC1\" />\n   143\t      <trace from=\".C57 > .pin1\" to=\"net.USB2ANY_3.3V\" />\n   144\t      <trace from=\".C57 > .pin2\" to=\"net.GND\" />\n   145\t      <trace from=\".U2 > .GND11\" to=\"net.GND\" />\n   146\t      <trace from=\".U2 > .GND12\" to=\"net.GND\" />\n   147\t\n   148\t      <trace from=\"net.CVDD\" to=\"net.CVDD_CO\" /> {/* J18 closed */}\n   149\t      <trace from=\"net.CVDD_CO\" to=\".U2 > .VCC2\" />\n   150\t      <trace from=\".C58 > .pin1\" to=\"net.CVDD_CO\" />\n   151\t      <trace from=\".C58 > .pin2\" to=\"net.GND\" />\n   152\t      <trace from=\".U2 > .GND21\" to=\"net.GND\" />\n   153\t      <trace from=\".U2 > .GND22\" to=\"net.GND\" />\n   154\t\n   155\t      {/* Signal Paths */}\n   156\t      <trace from=\".U1 > .TX\" to=\".U2 > .INC\" />\n   157\t      <trace from=\".U2 > .OUTC\" to=\"net.USB2ANY_RX_3.3\" />\n   158\t\n   159\t      <trace from=\"net.USB2ANY_TX_3.3\" to=\".U2 > .INB\" />\n   160\t      <trace from=\".U2 > .OUTB\" to=\"net.RX_CO\" />\n   161\t      <trace from=\"net.RX_CO\" to=\".U1 > .RX\" /> {/* J21 closed */}\n   162\t\n   163\t      <trace from=\".U1 > .NFAULT\" to=\".U2 > .IND\" />\n   164\t      <trace from=\".U2 > .OUTD\" to=\"net.NFAULT_C\" />\n   165\t\n   166\t      {/* Power Indicator */}\n   167\t      <A_150060GS75000 name=\"D1\" />\n   168\t      <resistor name=\"R121\" resistance=\"1k\" footprint=\"0603\" />\n   169\t      <trace from=\"net.CVDD\" to=\".R121 > .pin1\" />\n   170\t      <trace from=\".R121 > .pin2\" to=\".D1 > .pin2\" /> {/* Anode */}\n   171\t      <trace from=\".D1 > .pin1\" to=\"net.GND\" /> {/* Cathode */}\n   172\t    </group>\n   173\t\n   174\t    {/* Auxiliary Measurement */}\n   175\t    <group name=\"Auxiliary\">\n   176\t      <net name=\"SRP_S\" />\n   177\t      <net name=\"SRN_S\" />\n   178\t      <trace from=\"net.SRP_S\" to=\".U1 > .BBP2\" />\n   179\t      <trace from=\"net.SRN_S\" to=\".U1 > .BBN\" />\n   180\t    </group>\n   181\t\n   182\t    {/* Cell Voltage and Balancing Inputs */}\n   183\t    <group name=\"CellInputs\">\n   184\t      {/* VC0-VC16 and CB0-CB16 */}\n   185\t      {[...Array(17).keys()].map((i) => (\n   186\t        <group key={i}>\n   187\t          <net name={`VC${i}`} />\n   188\t          <net name={`CB${i}`} />\n   189\t          <trace from={`net.VC${i}`} to={`.U1 > .VC${i}`} />\n   190\t          <trace from={`net.CB${i}`} to={`.U1 > .CB${i}`} />\n   191\t        </group>\n   192\t      ))}\n   193\t    </group>\n   194\t\n   195\t    {/* Daisy Chain Communication */}\n   196\t    <group name=\"DaisyChain\">\n   197\t      <net name=\"COMHP\" />\n   198\t      <net name=\"COMHN\" />\n   199\t      <net name=\"COMLP\" />\n   200\t      <net name=\"COMLN\" />\n   201\t      <trace from=\"net.COMHP\" to=\".U1 > .COMHP\" />\n   202\t      <trace from=\"net.COMHN\" to=\".U1 > .COMHN\" />\n   203\t      <trace from=\"net.COMLP\" to=\".U1 > .COMLP\" />\n   204\t      <trace from=\"net.COMLN\" to=\".U1 > .COMLN\" />\n   205\t    </group>\n   206\t\n   207\t    {/* Reference Voltage */}\n   208\t    <group name=\"Reference\">\n   209\t      <capacitor name=\"C_REFHP\" capacitance=\"1uF\" footprint=\"0603\" /> {/* SCUD doesn't specify C for REFHP, but TP7 exists */}\n   210\t      <trace from=\".U1 > .REFHP\" to=\".C_REFHP > .pin1\" />\n   211\t      <trace from=\".C_REFHP > .pin2\" to=\"net.GND\" />\n   212\t    </group>\n   213\t\n   214\t    {/* Grounding */}\n   215\t    <trace from=\".U1 > .AVSS\" to=\"net.GND\" />\n   216\t    <trace from=\".U1 > .CVSS\" to=\"net.GND\" />\n   217\t    <trace from=\".U1 > .DVSS\" to=\"net.GND\" />\n   218\t    <trace from=\".U1 > .REFHM\" to=\"net.GND\" />\n   219\t    <trace from=\".U1 > .EP\" to=\"net.GND\" />\n   220\t\n   221\t  </board>\n   222\t)\n   223\t\n",
