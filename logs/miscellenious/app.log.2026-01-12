/>\n   126\t    <trace from=\".R7 > .pin2\" to=\".RT1 > .pin1\" />\n   127\t    <trace from=\".RT1 > .pin2\" to=\"net.GND\" />\n   128\t    <trace from=\".R7 > .pin2\" to=\".U1 > .GPIO8\" /> {/* J4 Jumper assumed closed */}\n   129\t\n   130\t    <trace from=\"net.PULLUP\" to=\".R8 > .pin1\" />\n   131\t    <trace from=\".R8 > .pin2\" to=\".RT2 > .pin1\" />\n   132\t    <trace from=\".RT2 > .pin2\" to=\"net.GND\" />\n   133\t    <trace from=\".R8 > .pin2\" to=\".U1 > .GPIO7\" />\n   134\t\n   135\t    <trace from=\"net.PULLUP\" to=\".R11 > .pin1\" />\n   136\t    <trace from=\".R11 > .pin2\" to=\".RT3 > .pin1\" />\n   137\t    <trace from=\".RT3 > .pin2\" to=\"net.GND\" />\n   138\t    <trace from=\".R11 > .pin2\" to=\".U1 > .GPIO6\" />\n   139\t\n   140\t    <trace from=\"net.PULLUP\" to=\".R14 > .pin1\" />\n   141\t    <trace from=\".R14 > .pin2\" to=\".RT4 > .pin1\" />\n   142\t    <trace from=\".RT4 > .pin2\" to=\"net.GND\" />\n   143\t    <trace from=\".R14 > .pin2\" to=\".U1 > .GPIO5\" />\n   144\t\n   145\t    <trace from=\"net.PULLUP\" to=\".R15 > .pin1\" />\n   146\t    <trace from=\".R15 > .pin2\" to=\".RT5 > .pin1\" />\n   147\t    <trace from=\".RT5 > .pin2\" to=\"net.GND\" />\n   148\t    <trace from=\".R15 > .pin2\" to=\".U1 > .GPIO4\" />\n   149\t\n   150\t    <trace from=\"net.PULLUP\" to=\".R16 > .pin1\" />\n   151\t    <trace from=\".R16 > .pin2\" to=\".RT6 > .pin1\" />\n   152\t    <trace from=\".RT6 > .pin2\" to=\"net.GND\" />\n   153\t    <trace from=\".R16 > .pin2\" to=\".U1 > .GPIO3\" />\n   154\t\n   155\t    <trace from=\"net.PULLUP\" to=\".R18 > .pin1\" />\n   156\t    <trace from=\".R18 > .pin2\" to=\".RT7 > .pin1\" />\n   157\t    <trace from=\".RT7 > .pin2\" to=\"net.GND\" />\n   158\t    <trace from=\".R18 > .pin2\" to=\".U1 > .GPIO2\" />\n   159\t\n   160\t    <trace from=\"net.PULLUP\" to=\".R19 > .pin1\" />\n   161\t    <trace from=\".R19 > .pin2\" to=\".RT8 > .pin1\" />\n   162\t    <trace from=\".RT8 > .pin2\" to=\"net.GND\" />\n  