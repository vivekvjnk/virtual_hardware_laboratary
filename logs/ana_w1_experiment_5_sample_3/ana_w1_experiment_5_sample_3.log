                             \"./lib/NCP18XH103F03RB\"\n\nexport default () => {\n  return (\n    <board width=\"150mm\" height=\"100mm\">\n      {/* Nets */}\n                 
                             <net name=\"PWR\" />\n      <net name=\"GND\" />\n      <net name=\"AVDD\" />\n      <net name=\"CVDD\" />\n      <net name=\"DVDD\"                
