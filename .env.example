# Virtual Hardware Laboratory (VHL) Environment Configuration
# Copy this file to .env and configure your environment:
#   cp .env.example .env

# ==============================================================================
# LLM / AI Model Credentials
# ==============================================================================
# Google Gemini / Vertex AI
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# VERTEXAI_LOCATION=us-central1

# ==============================================================================
# Shared Workspace & Project Directory
# ==============================================================================
# Shared project workspace directory used across vhl-runtime and vhl-agent-backend.
# Both services must point to the same filesystem path for host deployment.
VHL_WORKSPACE_DIR=./workspace

# ==============================================================================
# VHL Runtime Host Settings
# ==============================================================================
# Optional custom Python binary path (defaults to vhl-runtime/.venv/bin/python3 if unset)
# VHL_PYTHON_BIN=

# Runtime Service Ports
# PORT=8080
# VAP_PORT=8081
# VHL_TERMINAL_MCP_PORT=8082
# SNAPSHOT_PORT=8083

# Optional standalone runframe override (leave unset for bundled @tscircuit/cli runframe)
# RUNFRAME_STANDALONE_FILE_PATH=

# ==============================================================================
# VHL Agent Backend & Integration Settings
# ==============================================================================
# WebSocket connection to vhl-runtime Agent WebSocket Server (Port 1080)
VHL_WS_URL=ws://localhost:1080

# MCP Service Endpoints for Agent Backend
MCP_ENDPOINT=http://localhost:8081/mcp/vap
LIBRARIAN_MCP_URL=http://localhost:8082/sse

# Storage Configuration (minio or local)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT_URL=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# OBJECT_STORE_BUCKET=vhl

# ==============================================================================
# Optional Host URL overrides (A2A Network)
# ==============================================================================
# A2A_HOST_URL=http://127.0.0.1:8000
